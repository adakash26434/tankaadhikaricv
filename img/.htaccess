# Block PHP execution in upload directory (prevents uploaded-shell attacks)
<FilesMatch "\.ph(p[2-9]?|t|tml|ps|ar)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Disable script execution
Options -ExecCGI
AddHandler cgi-script .php .php3 .php4 .php5 .php7 .php8 .phtml .pl .py .cgi

# Allow only safe image types
<FilesMatch "\.(jpe?g|png|gif|webp|svg|ico)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
